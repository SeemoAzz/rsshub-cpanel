# Token X (obligatoire pour /twitter/*)
# Cookie auth_token depuis https://x.com (Cookie-Editor ou F12 > Application > Cookies)
TWITTER_AUTH_TOKEN=votre_auth_token_ici

# cPanel / Passenger fournit PORT automatiquement — ne pas modifier en production
# PORT=1200

# Cache mémoire (pas de Redis sur hébergement mutualisé)
CACHE_TYPE=memory

# Écouter sur toutes les interfaces (requis derrière Apache/Passenger)
LISTEN_INADDR_ANY=1

# Désactiver le cluster sur hébergement mutualisé
ENABLE_CLUSTER=0

NODE_ENV=production

# Optionnel : protéger l'instance avec une clé d'accès
# ACCESS_KEY=ma_cle_secrete
